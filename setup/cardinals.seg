# [{2A}{46}] = [ ̪   ͆ ]     Bridge Below, Bridge Above 
# [{46}{2A}] = [ ͆   ̪ ]     Bridge Above, Bridge Below 
# [{25}{0A}] = [ ̥   ̊ ]
# [{0A}{25}] = [ ̊   ̥ ]
# [{61}{5C}] = [ ͡  ͜  ]
# [{5C}{61}] = [ ͜  ͡  ]

# Labial Consonants
++-|---+ ---- -|---|--|00|000000|00 = m[{25}{0A}]                           # Vl Nasal
