+--|+--- +--- -|+--|+-|00|000000|00 = b[*{2A}{46}][{61}{5C}]ʙ[{2A}{46}]                     # V  Trilled Affricate
++-|---- ---- -|---|+-|00|000000|00 = ⱱ[{25}{0A}]                                           # Vl Tap
++-|---- ---- -|+--|+-|00|000000|00 = ⱱ                                                     # V  Tap
+--|+--- ---- -|---|+-|00|000000|00 = f                                                     # Vl Fricative
+--|+--- ---- -|+--|+-|00|000000|00 = v                                                     # V  Fricative
+--|---- ++-- -|---|+-|00|000000|00 = p[*{2A}{46}][{61}{5C}]f                               # Vl Affricate
+--|---- ++-- -|+--|+-|00|000000|00 = b[*{2A}{46}][{61}{5C}]v                               # V  Affricate
++-|++-- ---- -|---|+-|00|000000|00 = ʋ[{25}{0A}]                                           # Vl Approx
++-|++-- ---- -|+--|+-|00|000000|00 = ʋ                                                     # V  Approx

+--|---+ ---- -|---|+-|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]p[{2A}{46}]                                   # Vl PN Plosive
+--|---+ ---- -|+--|+-|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]b[{2A}{46}]                                   # V  PN Plosive
+--|---+ ---- -|+-+|+-|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]ɓ[{2A}{46}]                                   # V  PN Implosive
++-|+--+ ---- -|---|+-|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]ʙ<[{2A}{46}][{25}{0A}]>                       # Vl PN Trill
++-|+--+ ---- -|+--|+-|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]ʙ[{2A}{46}]                                   # V  PN Trill
+--|+--+ +--- -|---|+-|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]p[*{2A}{46}][{61}{5C}]ʙ<[{2A}{46}][{25}{0A}]> # Vl PN Trilled Affricate
+--|+--+ +--- -|+--|+-|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]b[*{2A}{46}][{61}{5C}]ʙ[{2A}{46}]             # V  PN Trilled Affricate
+--|+--+ ---- -|---|+-|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]f                                             # Vl PN Fricative
+--|+--+ ---- -|+--|+-|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]v                                             # V  PN Fricative
+--|---+ ++-- -|---|+-|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]p[*{2A}{46}][{61}{5C}]f                       # Vl PN Affricate
+--|---+ ++-- -|+--|+-|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]b[*{2A}{46}][{61}{5C}]v                       # V  PN Affricate
++-|++-+ ---- -|---|+-|00|000000|00 = ʋ[{25}{0A}]{03}                                       # Vl  N Approx
++-|++-+ ---- -|+--|+-|00|000000|00 = ʋ{03}                                                 # V   N Approx

# Alveolar/Dental Consonants
