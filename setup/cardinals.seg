# [{2A}{46}] = [ ̪   ͆ ]     Bridge Below, Bridge Above 
# [{46}{2A}] = [ ͆   ̪ ]     Bridge Above, Bridge Below 
# [{25}{0A}] = [ ̥   ̊ ]
# [{0A}{25}] = [ ̊   ̥ ]
# [{61}{5C}] = [ ͡  ͜  ]
# [{5C}{61}] = [ ͜  ͡  ]

# Labial Consonants
++-|---+ ---- -|---|--|00|000000|00 = m[{25}{0A}]                           # Vl Nasal
++-|---+ ---- -|+--|--|00|000000|00 = m                                     # V  Nasal
+--|---- ---- -|---|--|00|000000|00 = p                                     # Vl Plosive
+--|---- ---- -|+--|--|00|000000|00 = b                                     # V  Plosive
+--|---- ---- -|+-+|--|00|000000|00 = ɓ                                     # V  Implosive
++-|+--- ---- -|---|--|00|000000|00 = ʙ[{25}{0A}]                           # Vl Trill
++-|+--- ---- -|+--|--|00|000000|00 = ʙ                                     # V  Trill
++-|+--- +--- -|---|--|00|000000|00 = p[{61}{5C}]ʙ[{25}{0A}]                # Vl Trilled Affricate TODO: maybe should be [+son]?
++-|+--- +--- -|+--|--|00|000000|00 = b[{61}{5C}]ʙ                          # V  Trilled Affricate TODO: maybe should be [+son]?
++-|---- ---- -|---|--|00|000000|00 = ⱱ̟[{0A}{25}]                           # Vl Tap
++-|---- ---- -|+--|--|00|000000|00 = ⱱ̟                                     # V  Tap
+--|+--- ---- -|---|--|00|000000|00 = ɸ                                     # Vl Fricative
+--|+--- ---- -|+--|--|00|000000|00 = β                                     # V  Fricative
+--|---- +--- -|---|--|00|000000|00 = p[{61}{5C}]ɸ                          # Vl Affricate
+--|---- +--- -|+--|--|00|000000|00 = b[{61}{5C}]β                          # V  Affricate
++-|++-- ---- -|---|--|00|000000|00 = ɸ{1E}                                 # Vl Approx    # TODO: Check how [+nas] renders
++-|++-- ---- -|+--|--|00|000000|00 = β{1E}                                 # V  Approx    

+--|---+ ---- -|---|--|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]p                             # Vl PN Plosive
+--|---+ ---- -|+--|--|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]b                             # V  PN Plosive
+--|---+ ---- -|+-+|--|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]ɓ                             # V  PN Implosive
++-|+--+ ---- -|---|--|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]ʙ[{25}{0A}]                   # Vl PN Trill
++-|+--+ ---- -|+--|--|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]ʙ                             # V  PN Trill
++-|+--+ +--- -|---|--|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]p[{61}{5C}]ʙ[{25}{0A}]        # Vl PN Trilled Affricate   # TODO: maybe should be [+son]?
++-|+--+ +--- -|+--|--|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]b[{61}{5C}]ʙ                  # V  PN Trilled Affricate   # TODO: maybe should be [+son]?
+--|+--+ ---- -|---|--|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]ɸ                             # Vl PN Fricative
+--|+--+ ---- -|+--|--|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]β                             # V  PN Fricative
+--|---+ +--- -|---|--|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]p[{61}{5C}]ɸ                  # Vl PN Affricate
+--|---+ +--- -|+--|--|00|000000|00 = [ᵐⁿᶯᶮᵑᶰ]b[{61}{5C}]β                  # V  PN Affricate
++-|++-+ ---- -|---|--|00|000000|00 = ɸ<{1E}{03}>                           # Vl  N Approx
++-|++-+ ---- -|+--|--|00|000000|00 = β<{1E}{03}>                           # V   N Approx

# Labiodental Consonants
++-|---+ ---- -|---|+-|00|000000|00 = ɱ[{0A}{25}]                                           # Vl Nasal
++-|---+ ---- -|+--|+-|00|000000|00 = ɱ                                                     # V  Nasal
+--|---- ---- -|---|+-|00|000000|00 = p[{2A}{46}]                                           # Vl Plosive
+--|---- ---- -|+--|+-|00|000000|00 = b[{2A}{46}]                                           # V  Plosive
